# Paraíso del Río - plano 360° (SiteGround / Apache)
# Va en public_html de 360paraiso.cautivamarketing.com (o en la raíz de cualquier otro dominio).

DirectoryIndex index.html index.htm
Options -Indexes

# Siempre por HTTPS (el login de Firebase y el CRM lo necesitan). Solo afecta a este sitio.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # La aplicación (index, CRM, datos del tour) siempre se revalida: los cambios se ven al instante.
  <FilesMatch "\.(html?|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# tour/media y tour/lib tienen su propio .htaccess con cache largo
# (el player los pide con ?v=<fecha del export>, así que un nuevo export no queda cacheado).
